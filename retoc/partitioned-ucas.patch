+/// Read+Seek over a container split into partitions (`name.ucas`, `name_s1.ucas`, ...).
+/// Block offsets in the TOC are global; partition N starts at N * partition_size.
+struct PartitionedCas<'a> {
+    pools: &'a [FilePool],
+    partition_size: u64,
+    pos: u64,
+}
+impl std::io::Read for PartitionedCas<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        use std::io::{Seek, SeekFrom};
+        let (index, local) = if self.pools.len() <= 1 { (0, self.pos) } else { ((self.pos / self.partition_size) as usize, self.pos % self.partition_size) };
+        let pool = self.pools.get(index).ok_or_else(|| std::io::Error::new(std::io::ErrorKind::UnexpectedEof, format!("partition {index} does not exist")))?;
+        let max = if self.pools.len() <= 1 { buf.len() } else { buf.len().min((self.partition_size - local) as usize) };
+        let mut handle = pool.acquire()?;
+        let file = handle.file();
+        file.seek(SeekFrom::Start(local))?;
+        let n = std::io::Read::read(file, &mut buf[..max])?;
+        self.pos += n as u64;
+        Ok(n)
+    }
+}
+impl std::io::Seek for PartitionedCas<'_> {
+    fn seek(&mut self, pos: std::io::SeekFrom) -> std::io::Result<u64> {
+        match pos {
+            std::io::SeekFrom::Start(p) => self.pos = p,
+            std::io::SeekFrom::Current(d) => self.pos = self.pos.checked_add_signed(d).ok_or_else(|| std::io::Error::other("seek out of range"))?,
+            std::io::SeekFrom::End(_) => return Err(std::io::Error::other("SeekFrom::End is not supported on a partitioned container")),
+        }
+        Ok(self.pos)
+    }
+}
